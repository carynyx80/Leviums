# Port (Railway sets this automatically)
PORT=8080
# Attestation signing key (0x-prefixed 32-byte hex). If unset, a random ephemeral key is generated at startup.
SIGNER_PRIVATE_KEY=
# Primary BSC mainnet RPC (fallbacks: https://bsc-rpc.publicnode.com, https://bsc-dataseed1.defibit.io)
BSC_RPC_URL=https://bsc-dataseed.binance.org
# Treasury address that anchor transactions must be sent to
TREASURY_ADDRESS=0x7d6b84648Fe791b2a2623b8B4D6fbB00ce7daB76
# Directory for receipts.json persistence
DATA_DIR=./data
